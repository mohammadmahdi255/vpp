packet-generator new {		  \
  name udp0                 \
  limit 49546457546					\
  maxframe 25               \
  node ethernet-input				\
  interface loop0					\
  size 128-128						\
  worker 1							\
  data { IP6: 1.2.40 -> 3cfd.fed0.b6c8		\
    UDP: 2001:db01::3 -> 2003:db01::4			\
    UDP: 3000 - 63040 -> 400	- 599			\
    incrementing 80					\
  }								\
}

