set interface detunnel loop0 arc device-input
set interface udpi loop0 arc detunnel-v6-output node session-v6-lookup
set interface udpi loop0 arc detunnel-v4-output node session-v4-lookup
# set interface detunnel loop1 arc device-input
# set interface detunnel loop2 arc device-input

packet-generator enable
show packet-generator