loop create
set int state loop0 up

clear trace
trace add pg-input 100

packet-generator new {				\
  name udp							\
  limit 49546457546					\
  node ethernet-input				\
  interface loop0					\
  size 100-100						\
  worker 1							\
  data {							\
    IP4: 1.2.3 -> 4.5.6 vlan 1					\
    UDP: 192.168.0.0 - 192.188.255.255 -> 10.18.0.0 - 10.38.255.255		\
    UDP: 1000 -> 3000						\
    length 72							\
    incrementing 100						\
  }								\
}

set interface detunnel loop0 arc device-input
packet-generator enable
show packet-generator